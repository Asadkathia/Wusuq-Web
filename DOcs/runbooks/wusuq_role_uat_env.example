# Role UAT environment template
# Usage: export values then run `pnpm uat:roles`

UAT_API_BASE_URL=http://localhost:4000/api

UAT_SUPERADMIN_IDENTIFIER=superadmin@wusuq.com
UAT_SUPERADMIN_PASSWORD=password

UAT_ADMIN_IDENTIFIER=
UAT_ADMIN_PASSWORD=

UAT_CONSUMER_IDENTIFIER=
UAT_CONSUMER_PASSWORD=

UAT_CLERK_IDENTIFIER=
UAT_CLERK_PASSWORD=

# Optional RBAC assertions for GET /users
UAT_SUPERADMIN_USERS_STATUS=200
UAT_ADMIN_USERS_STATUS=200
UAT_CONSUMER_USERS_STATUS=403
UAT_CLERK_USERS_STATUS=403
