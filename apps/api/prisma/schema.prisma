generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  manager_admin
  staff_admin
  lead_admin
  lawyer
  consumer
  representative
  investor
  company
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  WAITING_APPROVAL
  COMPLETED
}

enum PaymentMode {
  JAZZ_CASH
  EASY_PAISA
  BANK_TRANSFER
}

enum ServiceType {
  JUDICIAL
  NON_JUDICIAL
}

enum TicketPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum WalletTransactionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum InvoiceStatus {
  GENERATED
  SENT
  PARTIALLY_PAID
  PAID
}

enum ClerkApprovalStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ElectionStatus {
  DRAFT
  ACTIVE
  FINALIZED
}

enum CaseStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum CaseEventType {
  CASE_CREATED
  CASE_UPDATED
  CASE_CLOSED
  CASE_REOPENED
  HEARING_SCHEDULED
  HEARING_UPDATED
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_IN_PROGRESS
  TICKET_COMPLETED
  DOCUMENT_UPLOADED
  NOTE_ADDED
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  phone              String?
  cnic               String?
  dateOfBirth        DateTime?
  gender             String?
  photoUrl           String?
  address            String?
  country            String?
  province           String?
  district           String?
  tehsil             String?
  city               String?
  postalCode         String?
  serviceFocus       String?
  court              String?
  courtCity          String?
  passwordHash       String
  hashedRefreshToken String?
  role               UserRole
  verified           Boolean     @default(false)
  isActive           Boolean     @default(true)
  walletBalance      Decimal     @default(0)
  currency           String      @default("PKR")
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  tickets            Ticket[]
  assignments        Assignment[]
  walletTransactions WalletTransaction[]
  createdElections   Election[]  @relation("ElectionCreator")
  notifications      Notification[]
  cases              Case[]
}

model Service {
  id          String      @id @default(cuid())
  name        String
  type        ServiceType
  category    String
  courtLevel  String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tickets        Ticket[]
  clerkCostRules ClerkCostRule[]
}

model Ticket {
  id              String              @id @default(cuid())
  batchNo         String              @unique
  consumerId      String
  serviceId       String
  status          TicketStatus        @default(PENDING)
  serviceCity     String?
  caseType        String?
  intakeFlow      String?
  formPayload     Json?
  deliveryCharges       Decimal             @default(0)
  printingCharges       Decimal             @default(0)
  attestedCharges       Decimal             @default(0)
  nonAttestedCharges    Decimal             @default(0)
  additionalCharges     Decimal             @default(0)
  discountPrice         Decimal             @default(0)
  additionalServiceCost Decimal             @default(0)
  clerkCost             Decimal             @default(0)
  clerkApprovalStatus   ClerkApprovalStatus @default(PENDING)
  clerkReceiptUrl       String?
  totalAmount           Decimal             @default(0)
  amountPaid      Decimal             @default(0)
  paymentStatus   TicketPaymentStatus @default(UNPAID)
  serviceCost     Decimal             @default(0)
  caseId          String?
  hearingId       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  consumer        User                @relation(fields: [consumerId], references: [id])
  service         Service             @relation(fields: [serviceId], references: [id])
  case            Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  hearing         Hearing?            @relation(fields: [hearingId], references: [id], onDelete: SetNull)
  history         TicketStatusHistory[]
  assignments     Assignment[]
  documents       TicketDocument[]
  walletPayments  WalletTransaction[]
  caseEvents      CaseEvent[]
  caseDocuments   CaseDocument[]
  invoice         Invoice?

  @@index([consumerId])
  @@index([status])
  @@index([paymentStatus])
}

model Election {
  id              String         @id @default(cuid())
  name            String
  bodyName        String
  province        String?
  city            String?
  year            Int
  tenure          String
  status          ElectionStatus @default(DRAFT)
  createdByUserId String?
  finalizedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       User?          @relation("ElectionCreator", fields: [createdByUserId], references: [id])
  candidates      Candidate[]
  cabinetSeats    CabinetSeat[]
  votes           Vote[]
}

model Candidate {
  id          String   @id @default(cuid())
  electionId  String
  position    String
  memberName  String
  votes       Int      @default(0)
  isWinner    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  election    Election @relation(fields: [electionId], references: [id])
  cabinetSeats CabinetSeat[]
  castVotes    Vote[]
}

model CabinetSeat {
  id           String   @id @default(cuid())
  electionId   String
  candidateId  String
  position     String
  memberName   String
  votes        Int      @default(0)
  year         Int
  tenure       String
  createdAt    DateTime @default(now())
  election     Election @relation(fields: [electionId], references: [id])
  candidate    Candidate @relation(fields: [candidateId], references: [id])
}

model Vote {
  id          String    @id @default(cuid())
  electionId  String
  candidateId String
  voterId     String
  position    String
  createdAt   DateTime  @default(now())
  election    Election  @relation(fields: [electionId], references: [id])
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@unique([electionId, voterId, position])
}

model TicketIntakeDraft {
  id            String   @id @default(cuid())
  flow          String
  consumerId    String
  serviceId     String?
  step          Int      @default(1)
  payload       Json?
  savedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TicketStatusHistory {
  id        String       @id @default(cuid())
  ticketId  String
  from      TicketStatus?
  to        TicketStatus
  note      String?
  createdAt DateTime     @default(now())
  ticket    Ticket       @relation(fields: [ticketId], references: [id])
}

model Assignment {
  id               String   @id @default(cuid())
  ticketId         String
  representativeId String
  createdAt        DateTime @default(now())
  ticket           Ticket   @relation(fields: [ticketId], references: [id])
  representative   User     @relation(fields: [representativeId], references: [id])
}

model TicketDocument {
  id        String   @id @default(cuid())
  ticketId  String
  name      String
  type      String
  fileUrl   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model WalletTransaction {
  id          String      @id @default(cuid())
  userId      String
  ticketId    String?
  amount      Decimal
  paymentMode PaymentMode
  currency    String      @default("PKR")
  status      WalletTransactionStatus @default(PENDING_VERIFICATION)
  receiptUrl  String?
  reviewedByUserId String?
  verifiedAt  DateTime?
  note        String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  ticket      Ticket?     @relation(fields: [ticketId], references: [id])

  @@index([userId])
  @@index([status])
}

model Invoice {
  id          String      @id @default(cuid())
  ticketId    String      @unique
  invoiceNo   String      @unique
  totalAmount Decimal
  amountPaid  Decimal     @default(0)
  dueAmount   Decimal
  status      InvoiceStatus @default(GENERATED)
  sentAt      DateTime?
  paidAt      DateTime?
  pdfUrl      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  ticket      Ticket      @relation(fields: [ticketId], references: [id])
}

model ClerkCostRule {
  id          String   @id @default(cuid())
  serviceId   String
  category    String
  caseType    String?
  province    String?
  yearFrom    Int
  yearTo      Int
  amount      Decimal
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  actorUserId String?
  actorEmail  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("system")
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model GeoProvince {
  id        String        @id @default(cuid())
  name      String        @unique
  districts GeoDistrict[]
}

model GeoDistrict {
  id         String       @id @default(cuid())
  provinceId String
  name       String
  province   GeoProvince  @relation(fields: [provinceId], references: [id])
  cities     GeoCity[]
}

model GeoCity {
  id             String             @id @default(cuid())
  districtId     String
  name           String
  district       GeoDistrict        @relation(fields: [districtId], references: [id])
  courts         GeoCourt[]
  policeStations GeoPoliceStation[]
}

model GeoCourt {
  id     String  @id @default(cuid())
  cityId String
  name   String
  level  String
  city   GeoCity @relation(fields: [cityId], references: [id])
}

model GeoPoliceStation {
  id     String  @id @default(cuid())
  cityId String
  name   String
  city   GeoCity @relation(fields: [cityId], references: [id])
}

model ExchangeRate {
  id         String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Decimal
  effectiveAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveAt])
}

model Case {
  id               String       @id @default(cuid())
  caseRef          String       @unique
  consumerId       String
  title            String
  type             ServiceType
  // Judicial context
  courtLevel       String?
  court            String?
  courtCity        String?
  caseNo           String?
  caseYear         Int?
  caseCategory     String?
  courtCaseStatus  String?
  judgeDesignation String?
  // Non-judicial context
  province         String?
  district         String?
  policeStation    String?
  firNo            String?
  offence          String?
  docNo            String?
  officeCity       String?
  // Parties
  petitioner       String?
  respondent       String?
  // Meta
  status           CaseStatus   @default(OPEN)
  notes            String?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  consumer         User         @relation(fields: [consumerId], references: [id])
  hearings         Hearing[]
  tickets          Ticket[]
  events           CaseEvent[]
  documents        CaseDocument[]

  @@index([consumerId])
  @@index([status])
}

model Hearing {
  id            String    @id @default(cuid())
  caseId        String
  scheduledDate DateTime
  hearingType   String?
  notes         String?
  outcome       String?
  nextDate      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  caseEvents    CaseEvent[]

  @@index([caseId])
}

model CaseEvent {
  id          String        @id @default(cuid())
  caseId      String
  type        CaseEventType
  title       String
  description String?
  actorUserId String?
  ticketId    String?
  hearingId   String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  case        Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ticket      Ticket?       @relation(fields: [ticketId], references: [id])
  hearing     Hearing?      @relation(fields: [hearingId], references: [id])

  @@index([caseId])
}

model CaseDocument {
  id               String   @id @default(cuid())
  caseId           String
  ticketId         String?
  name             String
  type             String
  fileUrl          String
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ticket           Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([caseId])
}
