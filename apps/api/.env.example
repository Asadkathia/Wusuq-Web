# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

PORT=4000
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Optional local-only override. Never enable in production.
ALLOW_START_WITHOUT_DB=false

# Payments
# Dev only: bypass consumer-payment gating so tickets can be assigned/progressed
# without a completed payment. Leave false/unset in production.
DISABLE_PAYMENT_GATING=false
PAYMENT_PROVIDER=mock
PAYMENT_RETURN_URL=http://localhost:3000/consumer/payments/return
PAYMENT_NOTIFY_URL=http://localhost:4000/api/payments/webhook/mock
